# Copy to secrets.yaml and fill in. Never commit secrets.yaml.
# api_key must be base64 of exactly 32 random bytes, e.g.: python3 -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
wifi_ssid: "your-ssid"
wifi_password: "change-me"
fallback_password: "change-me-too"
api_key: "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="  # placeholder, replace with a new random key
ota_password: "change-me-as-well"
