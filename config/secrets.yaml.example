# Copy to secrets.yaml and fill in. Never commit secrets.yaml.
# api_key: base64 of exactly 32 random bytes. Generate one with:  openssl rand -base64 32
# The CI replaces the placeholder with a fresh random key for compile-only builds.
wifi_ssid: "your-ssid"
wifi_password: "change-me"
fallback_password: "change-me-too"
api_key: "REPLACE-ME-with-openssl-rand-base64-32"
ota_password: "change-me-as-well"
